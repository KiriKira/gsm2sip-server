{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gsm2sip:rtc:v1:command",
  "title": "Experimental RTC v1 participant command",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "call_id",
    "leg_id",
    "attempt_id",
    "operation_id",
    "generation",
    "revision",
    "kind"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "call_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "not": {
        "pattern": "[^A-Za-z0-9_-]"
      }
    },
    "leg_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "not": {
        "pattern": "[^A-Za-z0-9_-]"
      }
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "not": {
        "pattern": "[^A-Za-z0-9_-]"
      }
    },
    "operation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "not": {
        "pattern": "[^A-Za-z0-9_-]"
      }
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "kind": {
      "enum": [
        "offer",
        "answer",
        "candidate",
        "end_of_candidates",
        "restart",
        "close"
      ]
    },
    "sdp": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536,
      "not": {
        "pattern": "\\u0000"
      }
    },
    "ice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate",
        "sdp_mid",
        "sdp_mline_index"
      ],
      "properties": {
        "candidate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "not": {
            "pattern": "[\\r\\n\\u0000]"
          }
        },
        "sdp_mid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "not": {
            "pattern": "[^A-Za-z0-9_-]"
          }
        },
        "sdp_mline_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "offer",
              "answer"
            ]
          }
        }
      },
      "then": {
        "required": [
          "sdp"
        ],
        "properties": {
          "ice": false,
          "revision": {
            "minimum": 1
          }
        }
      },
      "else": {
        "properties": {
          "sdp": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "candidate"
          }
        }
      },
      "then": {
        "required": [
          "ice"
        ]
      },
      "else": {
        "properties": {
          "ice": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "candidate",
              "end_of_candidates",
              "close"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "revision": {
            "const": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "restart"
          }
        }
      },
      "then": {
        "properties": {
          "revision": {
            "minimum": 1
          }
        }
      }
    }
  ]
}
