# Settings for deploy/compose.yaml. Copy to .env next to compose.yaml and
# keep it private (chmod 600). Never change SECRETS_ENCRYPTION_KEY after the
# first start; back it up together with the database.

# Image tag: "main" follows the latest main build; pin "sha-<7 chars>" or a
# release tag such as "v1.0.0" for repeatable deployments.
GSM2SIP_VERSION=main

# openssl rand -hex 24
POSTGRES_PASSWORD=
ARI_PASSWORD=
# openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=

# The API is published on HTTP_BIND_ADDR:HTTP_PORT. Keep 127.0.0.1 behind a
# reverse proxy; use 0.0.0.0 (or a LAN/Tailscale IP) to let
# phones connect with http:// directly.
HTTP_BIND_ADDR=127.0.0.1
HTTP_PORT=8080

# SIP_TRANSPORT=tls (default): SIP over TLS with SRTP media; SIP_SERVER_NAME
# must be in the certificate's SAN.
# SIP_TRANSPORT=udp: plain SIP and RTP for a trusted LAN or VPN (Tailscale);
# no certificate is needed: set SIP_PORT=5060 and both certificate paths below
# to /dev/null. SIP_SERVER_NAME may then be a LAN or Tailscale IP.
SIP_TRANSPORT=tls
SIP_SERVER_NAME=sip.example.com
SIP_PORT=5061
# 0.0.0.0 exposes SIP/RTP to phones; keep 127.0.0.1 on an SMS-only node.
SIP_BIND_ADDR=127.0.0.1
RTP_START=10000
RTP_END=10199
# The address phones use for SIP media behind Docker's port mapping (127.0.0.1
# on an SMS-only node). The all-in-one image with --network host needs none.
ASTERISK_EXTERNAL_SIGNALING_ADDRESS=127.0.0.1
ASTERISK_EXTERNAL_MEDIA_ADDRESS=127.0.0.1
# Certificate and key for SIP_SERVER_NAME (paths on this host).
ASTERISK_TLS_CERT_FILE=./sip.crt
ASTERISK_TLS_KEY_FILE=./sip.key
# Empty for a publicly trusted certificate. For a self-signed one, set
# /run/secrets/sip_tls_cert so phones receive it as their trust anchor.
SIP_CA_PEM_FILE=
SIP_ENABLE_OPUS=false

# Optional native WebRTC audio. SIP remains call control; enabled hosts fail
# closed if their chosen WebRTC leg cannot connect. See docs/webrtc-audio.md.
RTC_MEDIA_ENABLED=false
RTC_NODE_ID=local
RTC_STUN_URLS=
# For example turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
RTC_TURN_URLS=
# openssl rand -hex 32; same private value in API and coturn.
RTC_TURN_SHARED_SECRET=
