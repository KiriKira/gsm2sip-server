# Settings for deploy/compose.yaml. Copy to .env next to compose.yaml and
# keep it private (chmod 600). Never change SECRETS_ENCRYPTION_KEY after the
# first start; back it up together with the database.

# Image tag: "main" follows the latest main build; pin "sha-<7 chars>" or a
# release tag such as "v1.0.0" for repeatable deployments.
GSM2SIP_VERSION=main

# openssl rand -hex 24
POSTGRES_PASSWORD=
ARI_PASSWORD=
# openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=

# The API is published only on 127.0.0.1; put HTTPS in front of it.
HTTP_PORT=8080

# SIP over TLS. SIP_SERVER_NAME must be in the certificate's SAN.
SIP_SERVER_NAME=sip.example.com
SIP_PORT=5061
# 0.0.0.0 exposes SIP/RTP to phones; keep 127.0.0.1 on an SMS-only node.
SIP_BIND_ADDR=127.0.0.1
RTP_START=10000
RTP_END=10199
# The server's public IP (127.0.0.1 on an SMS-only node).
ASTERISK_EXTERNAL_SIGNALING_ADDRESS=127.0.0.1
ASTERISK_EXTERNAL_MEDIA_ADDRESS=127.0.0.1
# Certificate and key for SIP_SERVER_NAME (paths on this host).
ASTERISK_TLS_CERT_FILE=./sip.crt
ASTERISK_TLS_KEY_FILE=./sip.key
# Empty for a publicly trusted certificate. For a self-signed one, set
# /run/secrets/sip_tls_cert so phones receive it as their trust anchor.
SIP_CA_PEM_FILE=
SIP_ENABLE_OPUS=false
