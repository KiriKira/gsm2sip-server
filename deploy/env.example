# Settings for deploy/compose.yaml. Copy to .env next to compose.yaml and
# keep it private (chmod 600). Never change SECRETS_ENCRYPTION_KEY after the
# first start; back it up together with the database.

# Image tag: "main" follows the latest main build; pin "sha-<7 chars>" or a
# release tag such as "v0.4.0" for repeatable deployments and rollbacks.
GSM2SIP_VERSION=main

# openssl rand -hex 24
POSTGRES_PASSWORD=
# openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=

# The API is published on HTTP_BIND_ADDR:HTTP_PORT. Keep 127.0.0.1 behind a
# reverse proxy; use 0.0.0.0 (or a LAN/Tailscale IP) to let
# phones connect with http:// directly.
HTTP_BIND_ADDR=127.0.0.1
HTTP_PORT=8080

# ICE servers handed to both phones of a call. See docs/webrtc-audio.md.
RTC_STUN_URLS=
# For example turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
RTC_TURN_URLS=
# openssl rand -hex 32; same private value in API and coturn.
RTC_TURN_SHARED_SECRET=

# deploy/turn/compose.yaml; not needed by the all-in-one image.
# Linux host networking, no Docker port remapping:
# these are the actual host listening/allocation ports. Match RTC_*_URLS above
# and allow the same ports in the host firewall / cloud security group / NAT.
TURN_PUBLIC_IP=
TURN_PRIVATE_IP=
TURN_REALM=
TURN_LISTEN_PORT=3478
TURN_RELAY_MIN_PORT=49160
TURN_RELAY_MAX_PORT=49259
