# Development only. Keep the database password local and replace this value.
POSTGRES_PASSWORD=change-this-local-password
HTTP_PORT=8080
ARI_USERNAME=gsm2sip
ARI_PASSWORD=local-dev-change-me
SIP_SERVER_NAME=sip.localhost
SIP_PORT=5061
SIP_ENABLE_OPUS=false
SIP_BIND_ADDR=127.0.0.1
RTP_START=10000
RTP_END=10199
ASTERISK_EXTERNAL_SIGNALING_ADDRESS=127.0.0.1
ASTERISK_EXTERNAL_MEDIA_ADDRESS=127.0.0.1
ASTERISK_TLS_CERT_FILE=./.local/asterisk/sip.crt
ASTERISK_TLS_KEY_FILE=./.local/asterisk/sip.key
SIP_CA_PEM_FILE=/run/secrets/sip_tls_cert
# Required. The local probe generates a private, stable development key in .env.
SECRETS_ENCRYPTION_KEY=

# In managed environments, CODEX_PROXY_CERT may already be provided. Compose
# mounts it as a BuildKit secret; the empty local fallback keeps ordinary builds
# working without a proxy CA.
