# Development only. Keep the database password local and replace this value.
POSTGRES_PASSWORD=change-this-local-password
HTTP_PORT=8080
# Required. openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=
RTC_STUN_URLS=
RTC_TURN_URLS=
RTC_TURN_SHARED_SECRET=

# In managed environments, CODEX_PROXY_CERT may already be provided. Compose
# mounts it as a BuildKit secret; the empty local fallback keeps ordinary builds
# working without a proxy CA.
